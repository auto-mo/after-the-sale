# Copy to app/.env and fill in real values. Never commit app/.env.
# The API key is read only from this environment variable. It is never logged, never
# returned in any API response, and never sent to the browser.
ANTHROPIC_API_KEY=sk-ant-REPLACE_ME

# mock (default, zero cost) or anthropic (calls the real Claude API)
LLM_MODE=mock

# Exact model ID; do not change without re-checking the model docs.
MODEL=claude-haiku-4-5

# Daily spend cap in USD. Once today's spend reaches this, the assistant pauses and
# returns a friendly message instead of calling the model.
DAILY_BUDGET_USD=3

# Per-million-token prices used to compute spend from the API's usage fields.
PRICE_IN_PER_MTOK=1.0
PRICE_OUT_PER_MTOK=5.0

# Per-visitor rate limit (messages/hour), keyed on CF-Connecting-IP / X-Forwarded-For / remote addr.
RATE_PER_HOUR=20

# Conversation shape limits.
MAX_TURNS=12
MAX_MESSAGE_CHARS=1000
MAX_REPLY_TOKENS=800
MAX_TOOL_ROUNDS=5

# Optional: require a valid Cloudflare Turnstile token on the first message of a conversation.
# Leave blank to disable.
TURNSTILE_SECRET=

# Optional: require header X-Invite-Code to match this value on every request.
# Leave blank to disable.
INVITE_CODE=

# Where the daily spend ledger JSON file is stored.
LEDGER_PATH=app/.ledger.json

# When 1, Flask also serves web/ at / (dev convenience so front end and /api share an origin).
SERVE_STATIC=0

# Optional overrides; default relative to the repo root.
DATA_DIR=
WEB_DIR=
